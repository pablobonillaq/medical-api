# El paciente no puede ver la cita de otro paciente → 404
GET {{baseUrl}}/appointments/{{employeeAppointment.response.body.$.appointment.id}}

### Patient cancels their appointment → 200 (status: cancelled)
# El paciente cancela su cita → 200 (status: cancelled)
PATCH {{baseUrl}}/appointments/{{patientAppointment.response.body.$.appointment.id}}/cancel
Content-Type: application/json

{ "reason": "Tengo un viaje" }

### Cancel it again → 409
# Cancelarla otra vez → 409
PATCH {{baseUrl}}/appointments/{{patientAppointment.response.body.$.appointment.id}}/cancel

### The cancelled slot is free again → 200 (slots[0] appears again)
# El horario cancelado vuelve a estar libre → 200 (slots[0] aparece de nuevo)
GET {{baseUrl}}/availability?doctorId={{createDoctor.response.body.$.doctor.id}}&serviceId={{createService.response.body.$.service.id}}&date={{nextMonday}}


# =============================================================================
# Appointment changes / Cambios en citas
# Run the Appointments section first.
# Ejecuta antes la sección Appointments.
# State machine / Máquina de estados:
#   scheduled → confirmed | completed | no_show | cancelled
#   confirmed → completed | no_show | cancelled
#   cancelled, completed, no_show → (final / finales)
# =============================================================================

### Patient login → 200
# Login de paciente → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{patientEmail}}", "password": "{{patientPassword}}" }

### Patient books the third free slot → 201
# El paciente agenda el tercer horario libre → 201
# @name changeAppointment
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "doctorId": "{{createDoctor.response.body.$.doctor.id}}",
  "serviceId": "{{createService.response.body.$.service.id}}",
  "startsAt": "{{mondayAvailability.response.body.$.slots[2].startsAt}}"
}

### Patient confirms the appointment → 200 (status: confirmed)
# El paciente confirma la cita → 200 (status: confirmed)
PATCH {{baseUrl}}/appointments/{{changeAppointment.response.body.$.appointment.id}}/status
Content-Type: application/json

{ "status": "confirmed" }

### Confirm it again → 409 (no transition from confirmed to confirmed)
# Confirmarla otra vez → 409 (no hay transición de confirmed a confirmed)
PATCH {{baseUrl}}/appointments/{{changeAppointment.response.body.$.appointment.id}}/status
Content-Type: application/json

{ "status": "confirmed" }

### Patient marks it as no_show → 403 (only the doctor or staff record the outcome)
# El paciente la marca como no_show → 403 (solo el médico o el personal registran el resultado)
PATCH {{baseUrl}}/appointments/{{changeAppointment.response.body.$.appointment.id}}/status
Content-Type: application/json

{ "status": "no_show" }

### "cancelled" through /status → 400 (cancelling has its own endpoint)
# "cancelled" por /status → 400 (cancelar tiene su propio endpoint)
PATCH {{baseUrl}}/appointments/{{changeAppointment.response.body.$.appointment.id}}/status
Content-Type: application/json

{ "status": "cancelled" }

### Reschedule to the fourth free slot → 200 (status goes back to scheduled)
# Reprogramar al cuarto horario libre → 200 (el estado vuelve a scheduled)
PATCH {{baseUrl}}/appointments/{{changeAppointment.response.body.$.appointment.id}}/reschedule
Content-Type: application/json

{ "startsAt": "{{mondayAvailability.response.body.$.slots[3].startsAt}}" }

### Reschedule to the same time → 400
# Reprogramar a la misma hora → 400
PATCH {{baseUrl}}/appointments/{{changeAppointment.response.body.$.appointment.id}}/reschedule
Content-Type: application/json

{ "startsAt": "{{mondayAvailability.response.body.$.slots[3].startsAt}}" }

### Reschedule to a slot taken by another patient → 409
# Reprogramar a un horario ocupado por otra paciente → 409
PATCH {{baseUrl}}/appointments/{{changeAppointment.response.body.$.appointment.id}}/reschedule
Content-Type: application/json

{ "startsAt": "{{mondayAvailability.response.body.$.slots[1].startsAt}}" }

### Reschedule a cancelled appointment → 409
# Reprogramar una cita cancelada → 409
PATCH {{baseUrl}}/appointments/{{patientAppointment.response.body.$.appointment.id}}/reschedule
Content-Type: application/json

{ "startsAt": "{{mondayAvailability.response.body.$.slots[4].startsAt}}" }

### Doctor login → 200
# Login del médico → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{doctorEmail}}", "password": "{{doctorPassword}}" }

### Doctor marks an upcoming appointment as completed → 400 (it has not started)
# El médico marca como atendida una cita futura → 400 (todavía no empieza)
PATCH {{baseUrl}}/appointments/{{changeAppointment.response.body.$.appointment.id}}/status
Content-Type: application/json

{ "status": "completed" }

### Doctor tries to reschedule → 403 (doctors register time off instead)
# El médico intenta reprogramar → 403 (los médicos registran días libres)
PATCH {{baseUrl}}/appointments/{{changeAppointment.response.body.$.appointment.id}}/reschedule
Content-Type: application/json

{ "startsAt": "{{mondayAvailability.response.body.$.slots[4].startsAt}}" }


# =============================================================================
# Medical records / Expediente clínico
# Run the Appointment changes section first: "changeAppointment" makes the
# doctor one of the patient's treating doctors.
# Ejecuta antes la sección Appointment changes: "changeAppointment" convierte
# a la doctora en médica tratante de la paciente.
# Every request below is saved in the audit log.
# Cada petición de abajo queda registrada en la bitácora de auditoría.
# =============================================================================

### Doctor login → 200
# Login del médico → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{doctorEmail}}", "password": "{{doctorPassword}}" }

### Medical history before it exists → 200 with medicalHistory: null
# Antecedentes antes de que existan → 200 con medicalHistory: null
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/medical-history

### Create the medical history → 200
# Crear los antecedentes → 200
PUT {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/medical-history
Content-Type: application/json

{
  "bloodType": "O+",
  "allergies": "Penicilina",
  "chronicConditions": "Hipertensión arterial",
  "currentMedications": "Losartán 50 mg cada 24 horas"
}

### Replace it (PUT): fields not sent become null → 200
# Reemplazarlos (PUT): los campos que no se envían quedan en null → 200
PUT {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/medical-history
Content-Type: application/json

{
  "bloodType": "O+",
  "allergies": "Penicilina y sulfas",
  "chronicConditions": "Hipertensión arterial"
}

### Invalid blood type → 400
# Tipo de sangre inválido → 400
PUT {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/medical-history
Content-Type: application/json

{ "bloodType": "C+" }

### SOAP note for the appointment → 201
# Nota SOAP de la cita → 201
# @name clinicalNote
POST {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/notes
Content-Type: application/json

{
  "appointmentId": "{{changeAppointment.response.body.$.appointment.id}}",
  "subjective": "Dolor de garganta desde hace 3 días",
  "objective": "Faringe hiperémica, temperatura 37.8 °C",
  "assessment": "Faringitis aguda",
  "plan": "Paracetamol 500 mg cada 8 horas por 3 días"
}

### Second note for the same appointment → 409
# Segunda nota para la misma cita → 409
POST {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/notes
Content-Type: application/json

{
  "appointmentId": "{{changeAppointment.response.body.$.appointment.id}}",
  "subjective": "Control",
  "assessment": "Faringitis aguda",
  "plan": "Sin cambios"
}

### Note without assessment and plan → 400
# Nota sin evaluación ni plan → 400
POST {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/notes
Content-Type: application/json

{ "subjective": "Tos" }

### Amend the note (the original does not change) → 201
# Enmendar la nota (la original no cambia) → 201
# @name noteAmendment
POST {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/notes/{{clinicalNote.response.body.$.note.id}}/amendments
Content-Type: application/json

{
  "subjective": "Dolor de garganta desde hace 3 días",
  "objective": "Faringe hiperémica, temperatura 37.8 °C",
  "assessment": "Faringitis aguda",
  "plan": "Paracetamol 500 mg cada 8 horas por 5 días",
  "reason": "Duración del tratamiento incorrecta"
}

### Amend an amendment → 400 (amend the original note)
# Enmendar una enmienda → 400 (se enmienda la nota original)
POST {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/notes/{{noteAmendment.response.body.$.note.id}}/amendments
Content-Type: application/json

{
  "subjective": "Dolor de garganta",
  "assessment": "Faringitis aguda",
  "plan": "Paracetamol",
  "reason": "Otra corrección"
}

### List the notes → 200 (original notes with their amendments)
# Listar las notas → 200 (notas originales con sus enmiendas)
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/notes

### Get one note → 200
# Ver una nota → 200
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/notes/{{clinicalNote.response.body.$.note.id}}

### Other doctor login → 200
# Login del otro médico → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{otherDoctorEmail}}", "password": "{{otherDoctorPassword}}" }

### A doctor who does not treat the patient → 404 (recorded as denied)
# Un médico que no atiende a la paciente → 404 (se registra como denied)
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/medical-history

### Employee login → 200
# Login de empleado → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{employeeEmail}}", "password": "{{employeePassword}}" }

### Front desk cannot read clinical notes → 404 (recorded as denied)
# Recepción no puede leer notas clínicas → 404 (se registra como denied)
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/notes

### Patient login → 200
# Login de paciente → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{patientEmail}}", "password": "{{patientPassword}}" }

### Patient reads their medical history → 200
# La paciente consulta sus antecedentes → 200
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/medical-history

### Patient tries to change it → 403
# La paciente intenta modificarlos → 403
PUT {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/medical-history
Content-Type: application/json

{ "allergies": "Ninguna" }

### Patient reads their notes → 200
# La paciente consulta sus notas → 200
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/notes

### Who opened my record → 200 (doctors, employee and denied attempts; not my own visits)
# Quién consultó mi expediente → 200 (médicos, empleado e intentos denegados; no mis propias consultas)
GET {{baseUrl}}/patients/me/access-log

