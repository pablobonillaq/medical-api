### Front desk lists → 200, only its own upload
# Recepción lista → 200, solo lo que ella subió
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/attachments

### Front desk tries to download → 403 (recorded as denied)
# Recepción intenta descargar → 403 (se registra como denied)
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/attachments/{{employeeAttachment.response.body.$.attachment.id}}/download

### Doctor login → 200
# Login del médico → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{doctorEmail}}", "password": "{{doctorPassword}}" }

### Doctor lists every file of the patient → 200
# El médico lista todos los archivos de la paciente → 200
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/attachments

### Doctor reviews the patient's upload → 200 (status: reviewed)
# El médico revisa lo que subió la paciente → 200 (status: reviewed)
POST {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/attachments/{{patientAttachment.response.body.$.attachment.id}}/review

### Review it again → 409
# Revisarlo otra vez → 409
POST {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/attachments/{{patientAttachment.response.body.$.attachment.id}}/review

### Doctor voids the front desk upload → 200 (status: voided, the file is kept)
# El médico anula lo que subió recepción → 200 (status: voided, el archivo se conserva)
POST {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/attachments/{{employeeAttachment.response.body.$.attachment.id}}/void
Content-Type: application/json

{ "reason": "Referencia de otro paciente" }

### Void without a reason → 400
# Anular sin motivo → 400
POST {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/attachments/{{patientAttachment.response.body.$.attachment.id}}/void
Content-Type: application/json

{}

### Voided files only with includeVoided → 200
# Archivos anulados solo con includeVoided → 200
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/attachments?includeVoided=true

### Other doctor login → 200
# Login del otro médico → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{otherDoctorEmail}}", "password": "{{otherDoctorPassword}}" }

### A doctor who does not treat the patient → 404 (recorded as denied)
# Un médico que no atiende a la paciente → 404 (se registra como denied)
GET {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}/attachments


# =============================================================================
# Reminders / Recordatorios
# Reminders have no endpoints: booking an appointment schedules one 24 h before.
# Los recordatorios no tienen endpoints: agendar una cita programa uno 24 h antes.
#
# To see one in Mailpit (http://localhost:8025) without waiting:
# Para verlo en Mailpit (http://localhost:8025) sin esperar:
#   1. Run these requests / Ejecuta estas peticiones
#   2. Book an appointment (Appointments section) / Agenda una cita (sección Appointments)
#   3. docker exec medical-db psql -U medical -d medical_api -c "UPDATE appointment_reminders SET scheduled_for = now() WHERE status = 'pending';"
#   4. Wait up to a minute / Espera hasta un minuto
# =============================================================================

### Patient login → 200
# Login de paciente → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{patientEmail}}", "password": "{{patientPassword}}" }

### Patient agrees to email reminders → 200 (emailRemindersOptIn: true)
# La paciente acepta recordatorios por correo → 200 (emailRemindersOptIn: true)
PATCH {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}
Content-Type: application/json

{ "emailRemindersOptIn": true }

### Reminders to another address → 200 (contactEmail is used instead of the account email)
# Recordatorios a otro correo → 200 (se usa contactEmail en lugar del correo de la cuenta)
PATCH {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}
Content-Type: application/json

{ "contactEmail": "Luz.Mendez@Correo.TEST" }

### Invalid contact email → 400
# Correo de contacto inválido → 400
PATCH {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}
Content-Type: application/json

{ "contactEmail": "luz@" }

### Back to the account email → 200 (contactEmail: null)
# Volver al correo de la cuenta → 200 (contactEmail: null)
PATCH {{baseUrl}}/patients/{{registerPatient.response.body.$.patient.id}}
Content-Type: application/json

{ "contactEmail": null }

### Check the profile → 200 (contactEmail, emailRemindersOptIn)
# Revisar el perfil → 200 (contactEmail, emailRemindersOptIn)
GET {{baseUrl}}/patients/me

### Employee login → 200
# Login de empleado → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{employeeEmail}}", "password": "{{employeePassword}}" }

### Front desk registers a patient without an account, with email reminders → 201
# Recepción registra a un paciente sin cuenta, con recordatorios por correo → 201
POST {{baseUrl}}/patients
Content-Type: application/json

{
  "firstName": "Ramón",
  "lastName": "Soto",
  "birthDate": "1958-03-14",
  "phone": "55 8765 4321",
  "contactEmail": "ramon.soto@correo.test",
  "emailRemindersOptIn": true
}


# =============================================================================
# Permissions (patient) / Permisos (paciente)
# =============================================================================

### Patient login → 200
# Login de paciente → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{patientEmail}}", "password": "{{patientPassword}}" }

### Patient lists users → 403
# El paciente lista usuarios → 403
GET {{baseUrl}}/users

### Patient can read services → 200
# El paciente puede ver los servicios → 200
GET {{baseUrl}}/services

### Patient can read doctors → 200
# El paciente puede ver los médicos → 200
GET {{baseUrl}}/doctors

### Patient cannot see another patient → 404 (does not reveal that the id exists)
# El paciente no puede ver a otro paciente → 404 (no revela que el id existe)
GET {{baseUrl}}/patients/{{createWalkInPatient.response.body.$.patient.id}}

### Patient can read a doctor's schedule → 200
# El paciente puede ver el horario de un médico → 200
GET {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/schedule

### Patient cannot see a doctor's time off → 403
# El paciente no puede ver los días libres de un médico → 403
GET {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/time-off

### Patient tries to change a doctor's schedule → 403
# El paciente intenta cambiar el horario de un médico → 403
PUT {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/schedule
Content-Type: application/json

{ "blocks": [] }

### Patient tries to create a service → 403
# El paciente intenta crear un servicio → 403
POST {{baseUrl}}/services
Content-Type: application/json

{ "name": "Servicio no autorizado", "durationMinutes": 30 }
