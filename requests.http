# =============================================================================
# Medical API — manual requests (VS Code REST Client)
# Medical API — peticiones manuales (VS Code REST Client)
#
# EN: Run the requests in order. Cookies are kept between requests, so each
#     login applies to the requests that follow it. Credentials are read from
#     .env with {{$dotenv ...}}; never write real passwords in this file.
# ES: Ejecuta las peticiones en orden. Las cookies se conservan entre peticiones,
#     así que cada login aplica a las peticiones siguientes. Las credenciales se
#     leen del .env con {{$dotenv ...}}; nunca escribas contraseñas reales aquí.
# =============================================================================

@baseUrl = http://localhost:{{$dotenv PORT}}
@adminEmail = {{$dotenv ADMIN_EMAIL}}
@adminPassword = {{$dotenv ADMIN_PASSWORD}}

# Fictitious test data / Datos de prueba ficticios
@patientEmail = paciente@test.com
@patientPassword = 12345678
@employeeEmail = recepcion@clinica.test
@employeePassword = 12345678
@doctorEmail = dra.garay@clinica.test
@doctorPassword = 12345678
@otherDoctorEmail = dr.ruiz@clinica.test
@otherDoctorPassword = 12345678


# =============================================================================
# Health / Estado
# =============================================================================

### Health check → 200
# Estado de la API y de la base de datos → 200
GET {{baseUrl}}/health

### Unknown route → 404
# Ruta inexistente → 404
GET {{baseUrl}}/does-not-exist


# =============================================================================
# Auth / Autenticación
# =============================================================================

### Register a patient → 201
# Registro de paciente → 201
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "{{patientEmail}}", "password": "{{patientPassword}}" }

### Same email again → 409
# Mismo email otra vez → 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "{{patientEmail}}", "password": "{{patientPassword}}" }

### Invalid data → 400 with details per field
# Datos inválidos → 400 con detalle por campo
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "not-an-email", "password": "123" }

### Trying to register as admin → 201, but role is "patient"
# Intento de registrarse como admin → 201, pero con role "patient"
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "hacker@test.com", "password": "12345678", "role": "admin" }

### Wrong password → 401
# Contraseña incorrecta → 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{patientEmail}}", "password": "wrong-password" }

### Patient login → 200 and access_token cookie
# Login de paciente → 200 y cookie access_token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{patientEmail}}", "password": "{{patientPassword}}" }

### Current user (uses the login cookie) → 200
# Usuario actual (usa la cookie del login) → 200
GET {{baseUrl}}/auth/me

### Logout → 204
# Cerrar sesión → 204
POST {{baseUrl}}/auth/logout

### After logout → 401
# Después de cerrar sesión → 401
GET {{baseUrl}}/auth/me


# =============================================================================
# Users (admin) / Usuarios (admin)
# =============================================================================

### Admin login → 200
# Login como admin → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

### Create an employee account → 201 (409 if it already exists)
# Crear una cuenta de empleado → 201 (409 si ya existe)
# @name createEmployee
POST {{baseUrl}}/users
Content-Type: application/json

{ "email": "{{employeeEmail}}", "password": "{{employeePassword}}", "role": "employee" }

### Try to create a doctor from here → 400 (doctors are created from /doctors)
# Intentar crear un médico desde aquí → 400 (los médicos se crean desde /doctors)
POST {{baseUrl}}/users
Content-Type: application/json

{ "email": "other.doctor@test.com", "password": "12345678", "role": "doctor" }

### Try to create a patient from here → 400 (Invalid role)
# Intentar crear un paciente desde aquí → 400 (Invalid role)
POST {{baseUrl}}/users
Content-Type: application/json

{ "email": "other@test.com", "password": "12345678", "role": "patient" }

### List all users → 200
# Listar todos los usuarios → 200
GET {{baseUrl}}/users

### List employees only → 200
# Listar solo empleados → 200
GET {{baseUrl}}/users?role=employee

### Disable the employee → 200 (uses the id from "createEmployee")
# Desactivar al empleado → 200 (usa el id de "createEmployee")
PATCH {{baseUrl}}/users/{{createEmployee.response.body.$.user.id}}
Content-Type: application/json

{ "active": false }

### Empty PATCH → 400 with formErrors
# PATCH vacío → 400 con formErrors
PATCH {{baseUrl}}/users/{{createEmployee.response.body.$.user.id}}
Content-Type: application/json

{}

### Invalid id → 400
# Id inválido → 400
PATCH {{baseUrl}}/users/123
Content-Type: application/json

{ "active": true }

### Disabled employee tries to log in → 403 (Account is disabled)
# El empleado desactivado intenta iniciar sesión → 403 (Account is disabled)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{employeeEmail}}", "password": "{{employeePassword}}" }

### Admin login again → 200
# Login como admin otra vez → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

### Re-enable the employee → 200
# Reactivar al empleado → 200
PATCH {{baseUrl}}/users/{{createEmployee.response.body.$.user.id}}
Content-Type: application/json

{ "active": true }


# =============================================================================
# Services (admin) / Servicios (admin)
# =============================================================================

### Admin login → 200
# Login como admin → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

### Create a service → 201 (409 if the name already exists)
# Crear un servicio → 201 (409 si el nombre ya existe)
# @name createService
POST {{baseUrl}}/services
Content-Type: application/json

{ "name": "Consulta general", "description": "Valoración médica general", "durationMinutes": 30 }

### Create another service → 201
# Crear otro servicio → 201
POST {{baseUrl}}/services
Content-Type: application/json

{ "name": "Consulta de seguimiento", "durationMinutes": 20 }

### Duplicate name → 409
# Nombre repetido → 409
POST {{baseUrl}}/services
Content-Type: application/json

{ "name": "Consulta general", "durationMinutes": 30 }

### Invalid duration → 400 (not a multiple of 5)
# Duración inválida → 400 (no es múltiplo de 5)
POST {{baseUrl}}/services
Content-Type: application/json

{ "name": "Prueba", "durationMinutes": 37 }

### List active services → 200 (sorted by name)
# Listar servicios activos → 200 (ordenados por nombre)
GET {{baseUrl}}/services

### Disable a service → 200 (uses the id from "createService")
# Desactivar un servicio → 200 (usa el id de "createService")
PATCH {{baseUrl}}/services/{{createService.response.body.$.service.id}}
Content-Type: application/json

{ "active": false }

### Disabled service no longer appears → 200
# El servicio desactivado ya no aparece → 200
GET {{baseUrl}}/services

### Admin can still see inactive services → 200
# El admin todavía puede ver los servicios inactivos → 200
GET {{baseUrl}}/services?includeInactive=true

### Re-enable the service → 200
# Reactivar el servicio → 200
PATCH {{baseUrl}}/services/{{createService.response.body.$.service.id}}
Content-Type: application/json

{ "active": true }

### Service that does not exist → 404
# Servicio que no existe → 404
PATCH {{baseUrl}}/services/0190a7b2-0000-7000-8000-000000000000
Content-Type: application/json

{ "active": true }


# =============================================================================
# Doctors (admin) / Médicos (admin)
# Run "Create a service" in the Services section first.
# Ejecuta antes "Create a service" de la sección Services.
# =============================================================================

### Admin login → 200
# Login como admin → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

### Create a doctor (user + profile in one transaction) → 201 (409 if it already exists)
# Crear un médico (usuario + perfil en una transacción) → 201 (409 si ya existe)
# @name createDoctor
POST {{baseUrl}}/doctors
Content-Type: application/json

{
  "email": "{{doctorEmail}}",
  "password": "{{doctorPassword}}",
  "firstName": "Ana",
  "lastName": "Garay",
  "specialty": "Medicina general",
  "licenseNumber": "12345678"
}

### Same license number → 409
# Misma cédula → 409
POST {{baseUrl}}/doctors
Content-Type: application/json

{
  "email": "otro.medico@clinica.test",
  "password": "12345678",
  "firstName": "Luis",
  "lastName": "Pérez",
  "specialty": "Pediatría",
  "licenseNumber": "12345678"
}

### Invalid license number → 400
# Cédula inválida → 400
POST {{baseUrl}}/doctors
Content-Type: application/json

{
  "email": "otro.medico@clinica.test",
  "password": "12345678",
  "firstName": "Luis",
  "lastName": "Pérez",
  "specialty": "Pediatría",
  "licenseNumber": "ABC123"
}

### Assign services to the doctor → 200
# Asignar servicios al médico → 200
PUT {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/services
Content-Type: application/json

{ "serviceIds": ["{{createService.response.body.$.service.id}}"] }

### Assign a service that does not exist → 400
# Asignar un servicio que no existe → 400
PUT {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/services
Content-Type: application/json

{ "serviceIds": ["0190a7b2-0000-7000-8000-000000000000"] }

### List doctors → 200
# Listar médicos → 200
GET {{baseUrl}}/doctors

### Doctors who offer a service → 200
# Médicos que ofrecen un servicio → 200
GET {{baseUrl}}/doctors?serviceId={{createService.response.body.$.service.id}}

### Get one doctor → 200
# Ver un médico → 200
GET {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}

### Update the doctor's profile → 200
# Actualizar el perfil del médico → 200
PATCH {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}
Content-Type: application/json

{ "specialty": "Medicina familiar" }

### Try to change a doctor's role → 400
# Intentar cambiar el rol de un médico → 400
PATCH {{baseUrl}}/users/{{createDoctor.response.body.$.doctor.userId}}
Content-Type: application/json

{ "role": "employee" }

### Doctor login → 200
# Login del médico → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{doctorEmail}}", "password": "{{doctorPassword}}" }

### Doctor can view doctors → 200
# El médico puede ver los médicos → 200
GET {{baseUrl}}/doctors

### Doctor tries to create a doctor → 403
# El médico intenta crear un médico → 403
POST {{baseUrl}}/doctors
Content-Type: application/json

{
  "email": "x@clinica.test",
  "password": "12345678",
  "firstName": "Xavier",
  "lastName": "Yáñez",
  "specialty": "Cardiología",
  "licenseNumber": "1234567"
}


# =============================================================================
# Schedules and time off / Horarios y días libres
# Run "Create a doctor" in the Doctors section first.
# Ejecuta antes "Create a doctor" de la sección Doctors.
# Days: 1 = Monday … 7 = Sunday. Times: HH:mm, multiples of 5 minutes.
# Días: 1 = lunes … 7 = domingo. Horas: HH:mm, múltiplos de 5 minutos.
# =============================================================================

### Admin login → 200
# Login como admin → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

### Set the doctor's weekly schedule → 200 (blocks sorted, times as HH:mm)
# Definir el horario semanal del médico → 200 (bloques ordenados, horas en HH:mm)
PUT {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/schedule
Content-Type: application/json

{
  "blocks": [
    { "dayOfWeek": 1, "start": "09:00", "end": "14:00" },
    { "dayOfWeek": 1, "start": "16:00", "end": "19:00" },
    { "dayOfWeek": 3, "start": "09:00", "end": "13:30" },
    { "dayOfWeek": 5, "start": "10:00", "end": "15:00" }
  ]
}

### Overlapping blocks → 400 (message in formErrors)
# Bloques traslapados → 400 (mensaje en formErrors)
PUT {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/schedule
Content-Type: application/json

{
  "blocks": [
    { "dayOfWeek": 1, "start": "09:00", "end": "14:00" },
    { "dayOfWeek": 1, "start": "13:00", "end": "15:00" }
  ]
}

### Invalid day and times → 400
# Día y horas inválidos → 400
PUT {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/schedule
Content-Type: application/json

{ "blocks": [{ "dayOfWeek": 8, "start": "9:00", "end": "09:07" }] }

### Get the doctor's schedule → 200
# Ver el horario del médico → 200
GET {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/schedule

### Add time off → 201 (409 if it overlaps with another one)
# Agregar un día libre → 201 (409 si se traslapa con otro)
# @name createTimeOff
POST {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/time-off
Content-Type: application/json

{
  "startsAt": "2027-12-24T00:00:00-06:00",
  "endsAt": "2027-12-26T00:00:00-06:00",
  "reason": "Vacaciones"
}

### Overlapping time off → 409
# Día libre traslapado → 409
POST {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/time-off
Content-Type: application/json

{ "startsAt": "2027-12-25T09:00:00-06:00", "endsAt": "2027-12-25T14:00:00-06:00" }

### Date without time zone → 400
# Fecha sin zona horaria → 400
POST {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/time-off
Content-Type: application/json

{ "startsAt": "2027-12-31T00:00:00", "endsAt": "2028-01-01T00:00:00-06:00" }

### Time off in the past → 400
# Día libre en el pasado → 400
POST {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/time-off
Content-Type: application/json

{ "startsAt": "2020-01-01T00:00:00-06:00", "endsAt": "2020-01-02T00:00:00-06:00" }

### List upcoming time off → 200
# Listar los próximos días libres → 200
GET {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/time-off

### Create a second doctor → 201 (to test permissions between doctors)
# Crear un segundo médico → 201 (para probar permisos entre médicos)
# @name createOtherDoctor
POST {{baseUrl}}/doctors
Content-Type: application/json

{
  "email": "{{otherDoctorEmail}}",
  "password": "{{otherDoctorPassword}}",
  "firstName": "Jorge",
  "lastName": "Ruiz",
  "specialty": "Pediatría",
  "licenseNumber": "87654321"
}

### Doctor login → 200
# Login del médico → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{doctorEmail}}", "password": "{{doctorPassword}}" }

### Doctor updates their own schedule → 200
# El médico actualiza su propio horario → 200
PUT {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/schedule
Content-Type: application/json

{
  "blocks": [
    { "dayOfWeek": 1, "start": "09:00", "end": "14:00" },
    { "dayOfWeek": 3, "start": "09:00", "end": "13:30" },
    { "dayOfWeek": 5, "start": "10:00", "end": "15:00" }
  ]
}

### Doctor tries to change another doctor's schedule → 403
# El médico intenta cambiar el horario de otro médico → 403
PUT {{baseUrl}}/doctors/{{createOtherDoctor.response.body.$.doctor.id}}/schedule
Content-Type: application/json

{ "blocks": [{ "dayOfWeek": 2, "start": "08:00", "end": "12:00" }] }

### Doctor deletes their own time off → 204 (uses the id from "createTimeOff")
# El médico borra su propio día libre → 204 (usa el id de "createTimeOff")
DELETE {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/time-off/{{createTimeOff.response.body.$.timeOff.id}}

### Delete it again → 404
# Borrarlo otra vez → 404
DELETE {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/time-off/{{createTimeOff.response.body.$.timeOff.id}}


# =============================================================================
# Permissions (patient) / Permisos (paciente)
# =============================================================================

### Patient login → 200
# Login de paciente → 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{patientEmail}}", "password": "{{patientPassword}}" }

### Patient lists users → 403
# El paciente lista usuarios → 403
GET {{baseUrl}}/users

### Patient can read services → 200
# El paciente puede ver los servicios → 200
GET {{baseUrl}}/services

### Patient can read doctors → 200
# El paciente puede ver los médicos → 200
GET {{baseUrl}}/doctors

### Patient can read a doctor's schedule → 200
# El paciente puede ver el horario de un médico → 200
GET {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/schedule

### Patient cannot see a doctor's time off → 403
# El paciente no puede ver los días libres de un médico → 403
GET {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/time-off

### Patient tries to change a doctor's schedule → 403
# El paciente intenta cambiar el horario de un médico → 403
PUT {{baseUrl}}/doctors/{{createDoctor.response.body.$.doctor.id}}/schedule
Content-Type: application/json

{ "blocks": [] }

### Patient tries to create a service → 403
# El paciente intenta crear un servicio → 403
POST {{baseUrl}}/services
Content-Type: application/json

{ "name": "Servicio no autorizado", "durationMinutes": 30 }
