// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  doctor
  employee
  patient
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctor                Doctor?
  patient               Patient?
  createdAppointments   Appointment[]
  medicalHistoryUpdates MedicalHistory[]
  auditLogs             AuditLog[]
  sentMessages          Message[]

  uploadedAttachments Attachment[] @relation("AttachmentUploadedBy")
  reviewedAttachments Attachment[] @relation("AttachmentReviewedBy")
  voidedAttachments   Attachment[] @relation("AttachmentVoidedBy")

  @@map("users")
}

model Doctor {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  specialty     String
  licenseNumber String   @unique @map("license_number")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  services      DoctorService[]
  schedule      ScheduleBlock[]
  timeOff       TimeOff[]
  appointments  Appointment[]
  clinicalNotes ClinicalNote[]

  @@map("doctors")
}

model Service {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String   @unique
  description     String?
  durationMinutes Int      @map("duration_minutes")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctors      DoctorService[]
  appointments Appointment[]

  @@map("services")
}

model DoctorService {
  doctorId  String @map("doctor_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([doctorId, serviceId])
  @@index([serviceId])
  @@map("doctor_services")
}

model ScheduleBlock {
  id          String @id @default(uuid(7)) @db.Uuid
  doctorId    String @map("doctor_id") @db.Uuid
  dayOfWeek   Int    @map("day_of_week")
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
  @@map("schedule_blocks")
}

model TimeOff {
  id        String   @id @default(uuid(7)) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt])
  @@map("time_off")
}

model Patient {
  id                  String   @id @default(uuid(7)) @db.Uuid
  userId              String?  @unique @map("user_id") @db.Uuid
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  birthDate           DateTime @map("birth_date") @db.Date
  phone               String
  // Email for reminders. If empty, the email of the patient's account is used.
  contactEmail        String?  @map("contact_email")
  emailRemindersOptIn Boolean  @default(false) @map("email_reminders_opt_in")
  whatsappOptIn       Boolean  @default(false) @map("whatsapp_opt_in")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  medicalHistory MedicalHistory?
  clinicalNotes  ClinicalNote[]
  auditLogs      AuditLog[]
  conversation   Conversation?
  attachments    Attachment[]

  @@index([lastName, firstName])
  @@map("patients")
}

enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
  completed
  no_show
}

model Appointment {
  id                 String            @id @default(uuid(7)) @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  doctorId           String            @map("doctor_id") @db.Uuid
  serviceId          String            @map("service_id") @db.Uuid
  startsAt           DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime          @map("ends_at") @db.Timestamptz(3)
  status             AppointmentStatus @default(scheduled)
  notes              String?
  createdById        String?           @map("created_by_id") @db.Uuid
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?           @map("cancellation_reason")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor                @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  service      Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdBy    User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  clinicalNote ClinicalNote?
  reminders    AppointmentReminder[]

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

// Current state of the patient's background; every change is recorded in the audit log
model MedicalHistory {
  id                 String   @id @default(uuid(7)) @db.Uuid
  patientId          String   @unique @map("patient_id") @db.Uuid
  bloodType          String?  @map("blood_type")
  allergies          String?
  chronicConditions  String?  @map("chronic_conditions")
  currentMedications String?  @map("current_medications")
  surgicalHistory    String?  @map("surgical_history")
  familyHistory      String?  @map("family_history")
  updatedById        String   @map("updated_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  updatedBy User    @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("medical_histories")
}

// SOAP note. Append-only: mistakes are fixed with an amendment (a new note pointing to the original)
model ClinicalNote {
  id              String   @id @default(uuid(7)) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  doctorId        String   @map("doctor_id") @db.Uuid
  appointmentId   String?  @unique @map("appointment_id") @db.Uuid
  amendsNoteId    String?  @map("amends_note_id") @db.Uuid
  amendmentReason String?  @map("amendment_reason")
  subjective      String
  objective       String?
  assessment      String
  plan            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  amends      ClinicalNote?  @relation("NoteAmendments", fields: [amendsNoteId], references: [id], onDelete: Restrict)
  amendments  ClinicalNote[] @relation("NoteAmendments")
  attachments Attachment[]

  @@index([patientId, createdAt])
  @@index([amendsNoteId])
  @@map("clinical_notes")
}

enum AuditAction {
  read
  create
  update
  denied
}

enum AuditResource {
  medical_history
  clinical_note
  attachment
}

// Who accessed which record and when. Metadata only, never clinical content. Append-only
model AuditLog {
  id         String        @id @default(uuid(7)) @db.Uuid
  actorId    String        @map("actor_id") @db.Uuid
  actorRole  Role          @map("actor_role")
  action     AuditAction
  resource   AuditResource
  resourceId String?       @map("resource_id") @db.Uuid
  patientId  String        @map("patient_id") @db.Uuid
  ip         String?
  userAgent  String?       @map("user_agent")
  details    Json?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

enum ConversationStatus {
  open
  closed
}

// One conversation per patient with the clinic; the front desk answers it
model Conversation {
  id                String             @id @default(uuid(7)) @db.Uuid
  patientId         String             @unique @map("patient_id") @db.Uuid
  status            ConversationStatus @default(open)
  lastMessageAt     DateTime?          @map("last_message_at") @db.Timestamptz(3)
  patientLastReadAt DateTime?          @map("patient_last_read_at") @db.Timestamptz(3)
  clinicLastReadAt  DateTime?          @map("clinic_last_read_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  messages Message[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

// Messages are never edited or deleted (append-only, enforced by a trigger)
model Message {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  senderRole     Role     @map("sender_role")
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, id])
  @@map("messages")
}

enum AttachmentCategory {
  lab_result
  imaging
  prescription
  referral
  other
}

// A file in the patient's record. The file itself lives in storage (storageKey);
// the database keeps its metadata and SHA-256 hash. Never deleted: it can be voided.
model Attachment {
  id             String             @id @default(uuid(7)) @db.Uuid
  patientId      String             @map("patient_id") @db.Uuid
  clinicalNoteId String?            @map("clinical_note_id") @db.Uuid
  uploadedById   String             @map("uploaded_by_id") @db.Uuid
  uploaderRole   Role               @map("uploader_role")
  category       AttachmentCategory @default(other)
  description    String?
  originalName   String             @map("original_name")
  mimeType       String             @map("mime_type")
  sizeBytes      Int                @map("size_bytes")
  sha256         String             @db.Char(64)
  storageKey     String             @unique @map("storage_key")
  reviewedById   String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  voidedById     String?            @map("voided_by_id") @db.Uuid
  voidedAt       DateTime?          @map("voided_at") @db.Timestamptz(3)
  voidReason     String?            @map("void_reason")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinicalNote ClinicalNote? @relation(fields: [clinicalNoteId], references: [id], onDelete: Restrict)
  uploadedBy   User          @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy   User?         @relation("AttachmentReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  voidedBy     User?         @relation("AttachmentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@index([uploadedById])
  @@map("attachments")
}

enum ReminderKind {
  day_before
}

enum ReminderStatus {
  pending
  sent
  failed
  cancelled
  skipped
}

enum ReminderChannel {
  email
  whatsapp
}

// Outbox of reminders: created with the appointment, sent later by a background worker.
// The channel is chosen when sending, from the patient's consent at that moment.
model AppointmentReminder {
  id                String           @id @default(uuid(7)) @db.Uuid
  appointmentId     String           @map("appointment_id") @db.Uuid
  kind              ReminderKind     @default(day_before)
  scheduledFor      DateTime         @map("scheduled_for") @db.Timestamptz(3)
  status            ReminderStatus   @default(pending)
  channel           ReminderChannel?
  attempts          Int              @default(0)
  lastError         String?          @map("last_error")
  providerMessageId String?          @map("provider_message_id")
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, kind])
  @@index([status, scheduledFor])
  @@map("appointment_reminders")
}
