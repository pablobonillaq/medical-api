// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  doctor
  employee
  patient
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctor                Doctor?
  patient               Patient?
  createdAppointments   Appointment[]
  medicalHistoryUpdates MedicalHistory[]
  auditLogs             AuditLog[]
  sentMessages          Message[]

  @@map("users")
}

model Doctor {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  specialty     String
  licenseNumber String   @unique @map("license_number")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  services      DoctorService[]
  schedule      ScheduleBlock[]
  timeOff       TimeOff[]
  appointments  Appointment[]
  clinicalNotes ClinicalNote[]

  @@map("doctors")
}

model Service {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String   @unique
  description     String?
  durationMinutes Int      @map("duration_minutes")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctors      DoctorService[]
  appointments Appointment[]

  @@map("services")
}

model DoctorService {
  doctorId  String @map("doctor_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([doctorId, serviceId])
  @@index([serviceId])
  @@map("doctor_services")
}

model ScheduleBlock {
  id          String @id @default(uuid(7)) @db.Uuid
  doctorId    String @map("doctor_id") @db.Uuid
  dayOfWeek   Int    @map("day_of_week")
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
  @@map("schedule_blocks")
}

model TimeOff {
  id        String   @id @default(uuid(7)) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt])
  @@map("time_off")
}

model Patient {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String?  @unique @map("user_id") @db.Uuid
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  birthDate     DateTime @map("birth_date") @db.Date
  phone         String
  whatsappOptIn Boolean  @default(false) @map("whatsapp_opt_in")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  medicalHistory MedicalHistory?
  clinicalNotes  ClinicalNote[]
  auditLogs      AuditLog[]
  conversation   Conversation?

  @@index([lastName, firstName])
  @@map("patients")
}

enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
  completed
  no_show
}

model Appointment {
  id                 String            @id @default(uuid(7)) @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  doctorId           String            @map("doctor_id") @db.Uuid
  serviceId          String            @map("service_id") @db.Uuid
  startsAt           DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime          @map("ends_at") @db.Timestamptz(3)
  status             AppointmentStatus @default(scheduled)
  notes              String?
  createdById        String?           @map("created_by_id") @db.Uuid
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?           @map("cancellation_reason")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  clinicalNote ClinicalNote?

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

// Current state of the patient's background; every change is recorded in the audit log
model MedicalHistory {
  id                 String   @id @default(uuid(7)) @db.Uuid
  patientId          String   @unique @map("patient_id") @db.Uuid
  bloodType          String?  @map("blood_type")
  allergies          String?
  chronicConditions  String?  @map("chronic_conditions")
  currentMedications String?  @map("current_medications")
  surgicalHistory    String?  @map("surgical_history")
  familyHistory      String?  @map("family_history")
  updatedById        String   @map("updated_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  updatedBy User    @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("medical_histories")
}

// SOAP note. Append-only: mistakes are fixed with an amendment (a new note pointing to the original)
model ClinicalNote {
  id              String   @id @default(uuid(7)) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  doctorId        String   @map("doctor_id") @db.Uuid
  appointmentId   String?  @unique @map("appointment_id") @db.Uuid
  amendsNoteId    String?  @map("amends_note_id") @db.Uuid
  amendmentReason String?  @map("amendment_reason")
  subjective      String
  objective       String?
  assessment      String
  plan            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  amends      ClinicalNote?  @relation("NoteAmendments", fields: [amendsNoteId], references: [id], onDelete: Restrict)
  amendments  ClinicalNote[] @relation("NoteAmendments")

  @@index([patientId, createdAt])
  @@index([amendsNoteId])
  @@map("clinical_notes")
}

enum AuditAction {
  read
  create
  update
  denied
}

enum AuditResource {
  medical_history
  clinical_note
}

// Who accessed which record and when. Metadata only, never clinical content. Append-only
model AuditLog {
  id         String        @id @default(uuid(7)) @db.Uuid
  actorId    String        @map("actor_id") @db.Uuid
  actorRole  Role          @map("actor_role")
  action     AuditAction
  resource   AuditResource
  resourceId String?       @map("resource_id") @db.Uuid
  patientId  String        @map("patient_id") @db.Uuid
  ip         String?
  userAgent  String?       @map("user_agent")
  details    Json?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

enum ConversationStatus {
  open
  closed
}

// One conversation per patient with the clinic; the front desk answers it
model Conversation {
  id                String             @id @default(uuid(7)) @db.Uuid
  patientId         String             @unique @map("patient_id") @db.Uuid
  status            ConversationStatus @default(open)
  lastMessageAt     DateTime?          @map("last_message_at") @db.Timestamptz(3)
  patientLastReadAt DateTime?          @map("patient_last_read_at") @db.Timestamptz(3)
  clinicLastReadAt  DateTime?          @map("clinic_last_read_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  messages Message[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

// Messages are never edited or deleted (append-only, enforced by a trigger)
model Message {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  senderRole     Role     @map("sender_role")
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, id])
  @@map("messages")
}
